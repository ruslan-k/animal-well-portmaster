# Port-local ALSA config (agent 2026-09-30, audio A/B, forward fix).
# The system /mnt/SDCARD/.asoundrc sends pcm.!default through dmix (the skill
# measured a dmix XRun storm on TSPS).  This routes the port straight to hw:0,0
# through a plug layer so wine can still negotiate its format/rate (48 kHz
# stereo -> 96 kHz S32_LE); a bare "type hw" makes winealsa fail to open and the
# game goes silent.  AW_ALSA_DIRECT=0 in the launcher disables this.
pcm.!default {
    type plug
    slave {
        pcm "hw:0,0"
        format S32_LE
        rate 96000
    }
}
ctl.!default {
    type hw
    card 0
}
