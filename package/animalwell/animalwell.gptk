# Animal Well (keyboard) - TSPS gptokeyb mapping, agent 2026-09-30
# dpad/left stick: movement (arrows); A: jump (space, the game also takes Z on X)
# B: use item (x); Y: pause/menu (esc); START: enter; L1/R1: map/pages
back = esc
start = enter
up = up
down = down
left = left
right = right
a = space
b = x
x = z
y = esc
l1 = pageup
r1 = pagedown
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
